{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infcore.local/schema/gateway.schema.json",
  "title": "infcore gateway config",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "models"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "default": "127.0.0.1" },
        "trusted_proxies": { "type": "array", "items": { "type": "string" }, "description": "IPv4/CIDR of trusted reverse proxies. Only for requests from these addresses is the audited client_ip taken from X-Real-IP/X-Forwarded-For. Empty = trust nobody" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "max_concurrent_requests": { "type": "integer", "minimum": 1, "default": 64, "description": "Worker pool size = ceiling on concurrent requests (SSE holds a worker for the whole stream)" },
        "request_timeout_ms": { "type": "integer", "minimum": 0, "default": 120000, "description": "Timeout of the request to the backend (upstream)" },
        "read_timeout_ms": { "type": "integer", "minimum": 0, "default": 30000, "description": "Timeout for reading the request from the client (slowloris protection)" },
        "write_timeout_ms": { "type": "integer", "minimum": 0, "default": 120000, "description": "Timeout for writing the response to the client (frees the worker when an SSE consumer is dead)" },
        "max_body_bytes": { "type": "integer", "minimum": 0, "default": 8388608, "description": "Maximum request body size in bytes (OOM protection)" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authn": { "enum": ["api_key"], "default": "api_key" },
        "api_keys": { "type": "array", "items": { "type": "string" }, "description": "legacy: a flat list of keys (admin role)" },
        "rbac_enabled": { "type": "boolean", "default": true },
        "principals": {
          "type": "array",
          "description": "API key -> who (subject) and which role",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["api_key", "role"],
            "properties": {
              "api_key": { "type": "string" },
              "subject": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "roles": {
          "type": "array",
          "description": "Role -> allowlists of models and endpoints ('*' = any)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "allow_models": { "type": "array", "items": { "type": "string" } },
              "allow_endpoints": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sink": { "enum": ["file", "none"], "default": "file" },
            "path": { "type": "string", "description": "Path to the append-only JSONL journal" },
            "require": { "type": "boolean", "default": true, "description": "sink=file and the journal failed to open -> fail fast (serve no traffic without audit)" }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics_enabled": { "type": "boolean", "default": true },
        "metrics_path": { "type": "string", "default": "/metrics" }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "description": "Strict offline mode: all outbound connections are forbidden at runtime.",
      "properties": {
        "enforce_no_egress": { "type": "boolean", "default": true },
        "require_model_integrity": { "type": "boolean", "default": false, "description": "Release gate: managed model artifacts must declare and match sha256 + size_bytes" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lazy start-up of managed backends (models without a backend_url).",
      "properties": {
        "llama_server_bin": { "type": "string", "description": "Path to llama-server from our build" },
        "port_range_start": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8100 },
        "idle_timeout_ms": { "type": "integer", "minimum": 0, "default": 300000 },
        "startup_timeout_ms": { "type": "integer", "minimum": 0, "default": 120000 },
        "max_loaded_models": { "type": "integer", "minimum": 0, "default": 0, "description": "0 = unlimited; admission control for managed backends" },
        "max_parallel_starts": { "type": "integer", "minimum": 0, "default": 1, "description": "0 = unlimited; admission control for expensive model starts" },
        "rate_limit_per_minute": { "type": "integer", "minimum": 0, "default": 0, "description": "0 = disabled; per authenticated subject" }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name"],
      "properties": {
        "logical_name": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "gguf_path": { "type": "string", "description": "Local path to the GGUF file (offline)" },
        "arch": { "type": "string", "description": "general.architecture from the GGUF metadata" },
        "backend_url": { "type": "string", "description": "An external llama-server; if empty, the backend is managed by the runtime supervisor" },
        "upstream_model": { "type": "string", "description": "The model's name on the backend, if it differs from logical_name" },
        "modality": { "enum": ["text", "embedding", "vision", "rerank"], "default": "text" },
        "enabled": { "type": "boolean", "default": true },
        "n_ctx": { "type": "integer", "minimum": 512, "default": 8192 },
        "n_gpu_layers": { "type": "integer", "minimum": -1, "default": 0, "description": "Layers on the GPU. -1 = let llama.cpp fit the offload to the free VRAM (the flag is not passed to the backend); any explicit value disables that auto-fit" },
        "mmproj_path": { "type": "string", "description": "Projector for vision (mtmd), where applicable" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "Expected SHA-256 of gguf_path" },
        "size_bytes": { "type": "integer", "minimum": 1, "description": "Expected byte size of gguf_path" },
        "mmproj_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "Expected SHA-256 of mmproj_path" },
        "mmproj_size_bytes": { "type": "integer", "minimum": 1, "description": "Expected byte size of mmproj_path" },
        "license": { "type": "string", "description": "Model license/provenance label" },
        "source": { "type": "string", "description": "Model source/provenance label" }
      }
    }
  }
}
