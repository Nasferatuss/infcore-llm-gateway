# Пример файла секретов для gateway. Скопировать в gateway.env (НЕ коммитить).
# В gateway.yaml ссылаться так: "api_key": "env:INFCORE_KEY_ADMIN".
# Сгенерировать реальные значения:
#   openssl rand -hex 32
# Слабые значения и заглушки gateway отвергает на старте.
INFCORE_KEY_ADMIN=generate-with-openssl-rand-hex-32-admin
INFCORE_KEY_EMBED=generate-with-openssl-rand-hex-32-embed
INFCORE_KEY_RERANK=generate-with-openssl-rand-hex-32-rerank
