# Example secrets file for the gateway. Copy it to gateway.env (do NOT commit it).
# Reference it from gateway.yaml as: "api_key": "env:INFCORE_KEY_ADMIN".
# Generate real values with:
#   openssl rand -hex 32
# The gateway rejects weak and placeholder values at start-up.
INFCORE_KEY_ADMIN=generate-with-openssl-rand-hex-32-admin
INFCORE_KEY_EMBED=generate-with-openssl-rand-hex-32-embed
INFCORE_KEY_RERANK=generate-with-openssl-rand-hex-32-rerank
