# A SKELETON of the infcore build image. Build it once and push it to your deployment's
# registry as infcore/base-devel:1.7; the internet is permitted only here.
# Package names follow your OS's repository (the example is Debian-like).
# For RPM distributions, replace apt with dnf/apt-rpm and adjust the package names.

# FROM is your deployment's base OS. A public Debian is used here so the skeleton builds
# as-is; in an isolated network, substitute your own base image.
FROM debian:12-slim

# Toolchain + CMake + build utilities (from the internal package mirror).
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential g++ make ninja-build cmake git ca-certificates \
      # Vulkan SDK: headers + the shader compiler (glslc/glslangValidator)
      libvulkan-dev glslang-tools spirv-tools \
 && rm -rf /var/lib/apt/lists/*

# The CUDA toolkit (nvcc + dev libraries) for your GPU fleet, installed from the internal
# NVIDIA mirror. The version must cover architectures 75..90 (see profile-portable.cmake).
# Example (adapt the version and channel to your mirror):
#   RUN apt-get update && apt-get install -y cuda-toolkit-12-4 && rm -rf /var/lib/apt/lists/*
# A GPU is NOT required at build time (CMAKE_CUDA_ARCHITECTURES is pinned, not "native").

# Check with: cmake --version >= 3.21, nvcc --version, glslc --version.
