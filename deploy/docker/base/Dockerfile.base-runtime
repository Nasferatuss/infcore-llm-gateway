# A SKELETON of the infcore runtime image (tag: infcore/base-runtime:1.7). Strictly offline
# in production. Runtime libraries ONLY, no toolchain or SDK (minimal attack surface).
# Package names follow your OS's repository (the example is Debian-like).

# As in base-devel: a public Debian so the skeleton builds as-is.
FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 libstdc++6 \
      # Vulkan loader + ICD (with GGML_VULKAN=ON). The ICD must match your GPU driver.
      libvulkan1 \
 && rm -rf /var/lib/apt/lists/*

# The CUDA runtime (with GGML_CUDA=ON) from the internal mirror. Runtime only, not the toolkit:
#   RUN apt-get update && apt-get install -y cuda-cudart-12-4 libcublas-12-4 \
#    && rm -rf /var/lib/apt/lists/*
# The NVIDIA driver is NOT installed — it is passed through from the host by
# nvidia-container-toolkit.

# For a CPU-only deployment neither the CUDA nor the Vulkan runtime is needed — keep only
# libgomp/libstdc++.
