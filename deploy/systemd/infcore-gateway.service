# infcore gateway — a systemd unit for an offline deployment.
# BEFOREHAND (once, as root):
#   useradd -r -s /usr/sbin/nologin infcore          # the service user
#   install -d -o infcore -g infcore /opt/infcore/bin /opt/infcore/config
#   # put the binaries in /opt/infcore/bin and the config in /opt/infcore/config/gateway.yaml
#   # the journal directory /var/log/infcore is created by systemd itself (LogsDirectory=, below)
# Install: cp into /etc/systemd/system/, then systemctl daemon-reload && enable --now.
[Unit]
Description=infcore gateway (OpenAI-compatible gateway to local LLMs)
After=network.target
Documentation=file:/opt/infcore/docs/DEPLOY.md

[Service]
Type=simple
User=infcore
Group=infcore

# Secrets (API keys referenced as env:VAR in the config) are read from here; optional file.
EnvironmentFile=-/etc/infcore/gateway.env

ExecStart=/opt/infcore/bin/infcore_gateway /opt/infcore/config/gateway.yaml

# Audit journal rotation: SIGHUP -> the gateway reopens the journal at the same path.
# Triggered from /etc/logrotate.d/infcore (postrotate: systemctl reload). WITHOUT this,
# logrotate in create mode would leave the gateway writing to the renamed file while the new
# one stayed empty — the whole audit trail would leak into the archive silently.
# The config is NOT re-read: changing keys or models still requires a restart.
ExecReload=/bin/kill -HUP $MAINPID

# The gateway starts child llama-server processes itself. control-group guarantees that
# stopping or restarting the unit kills ALL of them (models included), leaving no orphans.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=2

# Baseline hardening. /dev stays accessible for the GPU (NVIDIA); the audit journal is writable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# systemd creates /var/log/infcore owned by User= (mode 0750) before the service starts, so
# no separate mkdir/chown is needed; the directory is automatically in ReadWritePaths.
LogsDirectory=infcore
LogsDirectoryMode=0750
ReadWritePaths=/var/log/infcore
LimitNOFILE=65536
TasksMax=512
UMask=0077

# The offline invariant enforced by the kernel: all egress is denied except loopback.
# Clients connect to the gateway — add their subnet to IPAddressAllow (e.g. 10.0.0.0/8).
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
